# Runtime data (never commit)
/data/
.smoke/
.testdata/
.pytest-tmp/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
.env
.env.*
!.env.example
config.json
.installed

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# WorkBuddy project data (keep)
