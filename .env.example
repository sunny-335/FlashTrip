# 仅引导级环境变量。业务配置（AI / 地图 / Redis / 审图号）一律在安装向导中填写，
# 落盘到 /data/config.json，不从这里读取。除 TZ 外统一前缀 FLASHTRIP_。

# 主密钥：用于 Fernet 加密 API Key 与签发 JWT。留空则由向导生成并强制提示下载备份。
# 一旦更换，已加密的 API Key 与已签发的登录态全部失效，必须长期保持一致。
FLASHTRIP_SECRET_KEY=

# 容器内 uvicorn 监听端口（默认 8000）。改动后必须同步调整 -p 映射与反向代理目标端口。
# 例：FLASHTRIP_PORT=6781 配合 -p 6781:6781；或保持 8000、只改映射 -p 6781:8000。
FLASHTRIP_PORT=8000

# 时区与日志（TZ 同时作为系统时区生效）
TZ=Asia/Shanghai
FLASHTRIP_LOG_LEVEL=INFO

# 可选：覆盖数据库连接串（默认 sqlite:////data/flashtrip.db）
# FLASHTRIP_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/flashtrip
# FLASHTRIP_REDIS_URL=redis://redis:6379/0
